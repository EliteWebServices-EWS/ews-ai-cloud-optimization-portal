{
  "name": "sisum-backend",
  "version": "1.0.0",
  "description": "SISU'M Cloud Optimization Decision Platform — Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:sprint12": "tsx --test tests/integration/tenant-administration/**/*.test.ts tests/unit/privileged-mfa.test.ts tests/unit/direct-http-identity.test.ts",
    "test:execution-planner": "tsx --test tests/unit/execution-model.test.ts tests/unit/execution-lifecycle.test.ts tests/unit/mock-execution-plan-repository.test.ts tests/unit/dynamodb-execution-plan-repository.test.ts tests/unit/dynamodb-execution-history-repository.test.ts tests/unit/execution-repository-factory.test.ts tests/unit/execution-template.test.ts",
    "test:execution-integration": "tsx --test tests/integration/execution-*.test.ts tests/integration/execution/**/*.test.ts",
    "test:execution-security": "tsx --test tests/security/execution-*.test.ts",
    "test:execution-contract": "tsx --test tests/contract/**/*.test.ts tests/unit/execution-adapters-aws.test.ts",
    "test:execution-performance": "tsx --test tests/performance/execution-performance.test.ts",
    "test:execution-validation": "tsx --test tests/integration/execution-*.test.ts tests/integration/execution/**/*.test.ts tests/security/execution-*.test.ts tests/contract/**/*.test.ts tests/performance/execution-performance.test.ts tests/unit/execution-orchestrator.test.ts tests/unit/execution-adapters-aws.test.ts tests/unit/execution-run-repository.test.ts tests/unit/execution-model.test.ts tests/unit/execution-lifecycle.test.ts tests/unit/mock-execution-plan-repository.test.ts",
    "validate:tenant-admin": "npm run test:sprint12",
    "migrate:persistence": "tsx scripts/migrate-memory-to-dynamodb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.0.0",
    "@aws-sdk/client-cloudfront": "^3.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-cost-explorer": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/client-ec2": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.0.0",
    "@aws-sdk/client-rds": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sts": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.1092.0",
    "@codegenie/serverless-express": "^5.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
